# Copy to .env and fill in. Never commit .env.

# Supabase (cloud database). Leave both empty to run on local SQLite only.
# Use the project URL and a server-only secret/service-role key.
# Apply supabase_urgent_fixes.sql before starting this version.
# Partial or invalid configuration stops startup; it never enables local writes.
SUPABASE_URL=
SUPABASE_KEY=

# Optional persistent directory for SQLite, local mirrors and local attachments.
# Defaults to server/. Tests supply their own isolated temporary directory.
APP_DATA_DIR=

# Signs login sessions. REQUIRED in production, at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Extra browser origins allowed to call the API, comma-separated.
# Leave empty when the frontend is served by this same server (the default setup).
ALLOWED_ORIGINS=

# Creates the first general-director account when the users table is empty.
# Required in production unless accounts already exist in Supabase.
# Remove both after the first successful sign-in.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
